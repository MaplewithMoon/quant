# 让 Git 自动识别文本/二进制，避免行尾与编码被破坏
# eol=lf：仓库内和工作区统一使用 LF，Windows 上也不会被自动转成 CRLF
#         （CI 在 Linux 上跑，统一 LF 可避免"整文件行尾变化"的假 diff）
* text=auto eol=lf

# ---- 二进制：禁止任何转换 ----
*.parquet binary
*.duckdb  binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary
*.zip     binary
*.7z      binary
*.rar     binary
*.exe     binary
*.pyd     binary
*.so      binary
*.dll     binary
*.pyc     binary

# ---- 文本：统一在仓库内使用 LF，检出时按平台还原 ----
*.py      text
*.md      text
*.txt     text
*.toml    text
*.yml     text
*.yaml    text
*.json    text
*.csv     text
*.cfg     text
*.ini     text

# 中文文档/Vim 里也能正常显示，且让 diff 把中文当文本
*.md      diff=text
